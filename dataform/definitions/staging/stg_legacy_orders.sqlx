config {
  type: "table",
  schema: "staging",
  description: "Legacy warehouse orders (Spark history + Beam daily drops), de-duplicated on order_id. Used to prove report parity.",
  assertions: { uniqueKey: ["order_id"] }
}

WITH unioned AS (
  SELECT order_id, customer_email, order_date, status, amount, ingest_ts FROM ${ref("legacy_orders")}
  UNION ALL
  SELECT order_id, customer_email, order_date, status, amount, ingest_ts FROM ${ref("legacy_orders_daily")}
)
SELECT * EXCEPT (rn) FROM (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY ingest_ts DESC) AS rn FROM unioned
) WHERE rn = 1
