config {
  type: "table",
  schema: "staging",
  assertions: {
    uniqueKey: ["order_id"],
    nonNull: ["order_id", "customer_id", "order_ts"],
    rowConditions: ["order_status IN ('delivered','shipped','processing','canceled','returned')"]
  }
}

SELECT
  o.order_id,
  c.canonical_customer_id AS customer_id,
  o.customer_id AS source_customer_id,
  LOWER(TRIM(o.order_status)) AS order_status,
  o.order_ts,
  o.updated_at
FROM ${ref("public_orders")} o
JOIN ${ref("stg_customers")} c USING (customer_id)
